# StefShield Node & JS/TS .gitattributes
# https://git-scm.com/docs/gitattributes

# Normalize all text files and enforce LF
* text=auto eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary

# Diff improvements
*.svg text        diff=xml
*.md              diff=markdown

*.json            diff=json
*.jsonc           diff=json
*.json5           diff=json

*.js              diff=javascript
*.jsx             diff=javascript
*.mjs             diff=javascript
*.cjs             diff=javascript

*.ts              diff=typescript
*.tsx             diff=typescript
*.d.ts            diff=typescript
*.mts             diff=typescript
*.cts             diff=typescript

.env              diff=none
*.env             diff=none
package-lock.json diff=none
yarn.lock         diff=none
pnpm-lock.yaml    diff=none

# GitHub Linguist overrides

# vendored dependencies
node_modules/**  linguist-vendored
vendor/**        linguist-vendored

# generated output
dist/**          linguist-generated
build/**         linguist-generated
*.map            linguist-generated
*.min.js         linguist-generated
*.min.css        linguist-generated

# documentation
docs/**          linguist-documentation
